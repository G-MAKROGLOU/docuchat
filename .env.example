# Whole system. ./setup.sh (Windows: .\setup.ps1) copies this file to .env. Do not commit .env.

# --- Required ---------------------------------------------------------------
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (OpenRouter model IDs)
LLM_REWRITE_MODEL=
LLM_GRADE_MODEL=
LLM_GENERATE_MODEL=
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Database. Compose builds the backend DATABASE_URL from these values.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Object storage. STORAGE_BACKEND is s3 or filesystem. Compose sets the endpoint to the storage service.
STORAGE_BACKEND=s3
S3_BUCKET=documents
S3_REGION=us-east-1
S3_ACCESS_KEY=dev-access
S3_SECRET_KEY=change-me

# --- Optional ---------------------------------------------------------------
# Langfuse. Tracing is a no-op when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Host ports. Change one when setup reports that the port is in use.
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
STORAGE_PORT=8333

# Hot reload. Bind mounts from Windows and macOS hosts do not forward file system events,
# so the watchers poll the files. On a native Linux host, leave both empty.
# Turbopack watcher (frontend next.config.ts, watchOptions.pollIntervalMs), in milliseconds.
NEXT_WATCH_POLL_INTERVAL_MS=1000
# Next.js Watchpack watcher (new routes, .env files).
WATCHPACK_POLLING=true
# The backend needs no variable: Uvicorn's stat-based reloader always polls.

# Published images (compose.images.yml only): a commit hash or latest.
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_TAG=latest
