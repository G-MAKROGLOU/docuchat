# Copy to .env and set the values. Do not commit .env.

# Server-side URL of the backend. In Docker Compose this is the backend service name.
BACKEND_URL=http://backend:8000

# Hot reload in containers.
# Bind mounts from Windows and macOS hosts do not forward file system events.
# These variables make the watchers poll the files instead.
# Turbopack watcher (read by next.config.ts, watchOptions.pollIntervalMs).
# Leave empty to disable polling, for example on a native Linux host.
NEXT_WATCH_POLL_INTERVAL_MS=1000
# Watchpack watcher (new routes, .env files).
WATCHPACK_POLLING=true
