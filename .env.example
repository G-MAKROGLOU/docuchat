# Copy to .env and set the values. Do not commit .env.

# Database (db service). DATABASE_URL must use the same values.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
DATABASE_URL=postgresql://app:change-me@db:5432/app

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (OpenRouter model IDs)
LLM_REWRITE_MODEL=
LLM_GRADE_MODEL=
LLM_GENERATE_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Langfuse (optional). Tracing is a no-op when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Path to the docuchat-frontend clone, relative to this folder.
# docker-compose.yml builds the frontend from it and reads its .env file.
FRONTEND_PATH=../docuchat-frontend

# Hot reload: Uvicorn uses its stat-based reloader, which polls the files.
# It works on Windows, macOS and Linux hosts. No variable is necessary.
# The frontend polling variables are in docuchat-frontend/.env.example.
