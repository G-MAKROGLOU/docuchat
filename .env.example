# Frontend alone. Copy to .env and set the values. Do not commit .env.

# Backend base URL. The proxy route forwards /api/* to ${BACKEND_URL}/api/*.
# The browser never calls this host directly. Choose one mode:
#   Local backend (docuchat-backend compose.dev.yml):  http://localhost:8000
#   Deployed dev backend:                               https://<dev-backend-host>
#   Umbrella Compose (set there, not here):             http://backend:8000
BACKEND_URL=http://localhost:8000

# Schema source for `npm run contract:generate`: a URL or a file.
# Default: contract/stream-events.schema.json (the committed copy).
# Example: http://localhost:8000/api/v1/schemas/stream-events.json
CONTRACT_SOURCE=

# Hot reload in containers only.
# Bind mounts from Windows and macOS hosts do not forward file system events.
# Turbopack watcher (next.config.ts, watchOptions.pollIntervalMs). Empty: no polling.
NEXT_WATCH_POLL_INTERVAL_MS=
# Watchpack watcher (new routes, .env files).
WATCHPACK_POLLING=
