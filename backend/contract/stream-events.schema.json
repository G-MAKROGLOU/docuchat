{
  "title": "StreamEvent",
  "$defs": {
    "ClarifyEvent": {
      "description": "The drug name matches more than one label; a final event with the question follows.",
      "properties": {
        "type": {
          "const": "clarify",
          "default": "clarify",
          "title": "Type",
          "type": "string"
        },
        "candidates": {
          "items": {
            "type": "string"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "type",
        "candidates"
      ],
      "title": "ClarifyEvent",
      "type": "object"
    },
    "ErrorEvent": {
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "FinalEvent": {
      "properties": {
        "type": {
          "const": "final",
          "default": "final",
          "title": "Type",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "type",
        "answer",
        "citations"
      ],
      "title": "FinalEvent",
      "type": "object"
    },
    "RefusalEvent": {
      "properties": {
        "type": {
          "const": "refusal",
          "default": "refusal",
          "title": "Type",
          "type": "string"
        },
        "reason": {
          "enum": [
            "no_relevant_context",
            "no_valid_citation",
            "out_of_scope",
            "drug_not_in_corpus"
          ],
          "title": "Reason",
          "type": "string"
        },
        "available_drugs": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Available Drugs"
        }
      },
      "required": [
        "type",
        "reason",
        "available_drugs"
      ],
      "title": "RefusalEvent",
      "type": "object"
    },
    "Source": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "document": {
          "title": "Document",
          "type": "string"
        },
        "drug": {
          "title": "Drug",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "anchor": {
          "default": "",
          "title": "Anchor",
          "type": "string"
        }
      },
      "required": [
        "id",
        "document",
        "drug",
        "section",
        "page",
        "text",
        "anchor"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourcesEvent": {
      "properties": {
        "type": {
          "const": "sources",
          "default": "sources",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "SourcesEvent",
      "type": "object"
    },
    "StatusEvent": {
      "properties": {
        "type": {
          "const": "status",
          "default": "status",
          "title": "Type",
          "type": "string"
        },
        "stage": {
          "enum": [
            "rewrite",
            "retrieve",
            "grade",
            "generate",
            "verify"
          ],
          "title": "Stage",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "stage",
        "message"
      ],
      "title": "StatusEvent",
      "type": "object"
    },
    "SuggestionsEvent": {
      "description": "Follow-up questions; sent after the final event of an answer or a reply.",
      "properties": {
        "type": {
          "const": "suggestions",
          "default": "suggestions",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "type": "string"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "SuggestionsEvent",
      "type": "object"
    },
    "TokenEvent": {
      "properties": {
        "type": {
          "const": "token",
          "default": "token",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TokenEvent",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "clarify": "#/$defs/ClarifyEvent",
      "error": "#/$defs/ErrorEvent",
      "final": "#/$defs/FinalEvent",
      "refusal": "#/$defs/RefusalEvent",
      "sources": "#/$defs/SourcesEvent",
      "status": "#/$defs/StatusEvent",
      "suggestions": "#/$defs/SuggestionsEvent",
      "token": "#/$defs/TokenEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/StatusEvent"
    },
    {
      "$ref": "#/$defs/SourcesEvent"
    },
    {
      "$ref": "#/$defs/TokenEvent"
    },
    {
      "$ref": "#/$defs/FinalEvent"
    },
    {
      "$ref": "#/$defs/RefusalEvent"
    },
    {
      "$ref": "#/$defs/ClarifyEvent"
    },
    {
      "$ref": "#/$defs/SuggestionsEvent"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    }
  ]
}
