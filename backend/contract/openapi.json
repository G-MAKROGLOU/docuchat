            }
          },
          {
            "name": "filename",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Filename"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The whole PDF.",
            "content": {
              "application/pdf": {}
            }
          },
          "206": {
            "content": {
              "application/pdf": {}
            },
            "description": "One byte range."
          },
          "404": {
            "description": "Unknown document."
          },
          "416": {
            "description": "Range not satisfiable."
          },
