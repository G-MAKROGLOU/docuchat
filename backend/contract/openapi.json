              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ingestion": {
      "post": {
        "tags": [
          "ingestion"
        ],
        "summary": "Start Ingestion",
        "operationId": "start_ingestion_api_v1_ingestion_post",
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IngestionStarted"
                }
              }
            }
          },
          "409": {
            "description": "An ingestion pass is already running."
          }
        }
      }
    },
    "/api/v1/labels": {
      "get": {
        "tags": [
          "labels"
        ],
        "summary": "List Labels",
        "operationId": "list_labels_api_v1_labels_get",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 10,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "labels"
        ],
        "summary": "Queue Label",
        "operationId": "queue_label_api_v1_labels_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddLabelRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogLabelResponse"
                }
              }
            }
          },
          "404": {
            "description": "The catalogue does not know this set ID."
          },
          "502": {
            "description": "DailyMed could not be reached."
          },
          "409": {
            "description": "The label is in the corpus or in the queue."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/labels/search": {
      "get": {
        "tags": [
          "labels"
        ],
        "summary": "Search Labels",
        "description": "Labels that DailyMed has for the name, without those in the corpus or in the queue.",
        "operationId": "search_labels_api_v1_labels_search_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 100,
              "title": "Q"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogLabelResponse"
                  },
                  "title": "Response Search Labels Api V1 Labels Search Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/labels/{set_id}": {
      "delete": {
        "tags": [
          "labels"
        ],
        "summary": "Remove Label",
        "operationId": "remove_label_api_v1_labels__set_id__delete",
        "parameters": [
          {
            "name": "set_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Set Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "404": {
            "description": "No queued or failed entry with this set ID."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Read Settings",
        "operationId": "read_settings_api_v1_settings_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "summary": "Update Settings",
        "operationId": "update_settings_api_v1_settings_put",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsSaved"
                }
              }
            }
          },
          "422": {
            "description": "A value is invalid, or OpenRouter does not list a model ID."
          },
          "409": {
            "description": "A chunk change needs confirmation, or a pass is running."
          }
        }
      }
    },
    "/api/v1/settings/options": {
      "get": {
        "tags": [
          "settings"
        ],
        "summary": "Read Options",
        "operationId": "read_options_api_v1_settings_options_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingsOptions"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddLabelRequest": {
        "properties": {
          "set_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$",
            "title": "Set Id"
          }
        },
        "type": "object",
        "required": [
          "set_id"
        ],
        "title": "AddLabelRequest"
      },
      "AskRequest": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "AskRequest"
      },
      "CatalogLabelResponse": {
        "properties": {
          "set_id": {
            "type": "string",
            "title": "Set Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "published": {
            "type": "string",
            "title": "Published"
          }
        },
        "type": "object",
        "required": [
          "set_id",
          "title",
          "version",
          "published"
        ],
        "title": "CatalogLabelResponse"
      },
      "ConversationCreated": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          }
        },
        "type": "object",
        "required": [
          "id"
        ],
        "title": "ConversationCreated"
      },
      "ConversationOut": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "turns": {
            "items": {
              "$ref": "#/components/schemas/TurnOut"
            },
            "type": "array",
            "title": "Turns"
          }
        },
        "type": "object",
        "required": [
          "id",
          "turns"
        ],
        "title": "ConversationOut"
      },
      "DatabaseHealth": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "extensions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Extensions"
          }
        },
        "type": "object",
        "required": [
          "connected",
          "extensions"
        ],
        "title": "DatabaseHealth"
      },
      "DocumentListResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/DocumentSummary"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size"
        ],
        "title": "DocumentListResponse"
      },
      "DocumentStatus": {
        "type": "string",
        "enum": [
          "stored",
          "ingesting",
          "ingested",
          "failed"
        ],
        "title": "DocumentStatus"
      },
      "DocumentSummary": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "brand_name": {
            "type": "string",
            "title": "Brand Name"
          },
          "generic_name": {
            "type": "string",
            "title": "Generic Name"
          },
          "page_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Count"
          },
          "status": {
            "$ref": "#/components/schemas/DocumentStatus"
          },
          "ingested_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ingested At"
          },
          "failure_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failure Reason"
          }
        },
        "type": "object",
        "required": [
          "id",
          "brand_name",
          "generic_name",
          "page_count",
          "status",
          "ingested_at",
          "failure_reason"
        ],
        "title": "DocumentSummary"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseHealth"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "HealthResponse"
      },
      "IngestionStarted": {
        "properties": {
          "running": {
            "type": "boolean",
            "title": "Running"
          }
        },
        "type": "object",
        "required": [
          "running"
        ],
        "title": "IngestionStarted"
      },
      "QueueEntryResponse": {
        "properties": {
          "set_id": {
            "type": "string",
            "title": "Set Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "status": {
            "type": "string",
            "enum": [
