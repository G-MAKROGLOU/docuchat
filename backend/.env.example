# Backend: API, ingest worker and corpus init. infra/setup.sh (Windows: infra\setup.ps1)
# copies this file to .env. Do not commit .env.

# --- Required ---------------------------------------------------------------
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (OpenRouter model IDs)
# Intake, rewrite and grade use a cheap model; only the answer uses the stronger one.
# The eval in backend/evals scored Haiku for rewrite and grade as high as Opus at about 60% less cost.
LLM_CHAT_MODEL=anthropic/claude-haiku-5.5
LLM_REWRITE_MODEL=anthropic/claude-haiku-5.5
LLM_GRADE_MODEL=anthropic/claude-haiku-5.5
LLM_GENERATE_MODEL=anthropic/claude-opus-5.5
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Prefix each embedded chunk with its drug and section (true or false, for the ablation).
EMBEDDING_PREFIX=true

# Object storage. STORAGE_BACKEND is s3 or filesystem. The S3 keys are in infra/.env; Docker
# Compose passes them and the endpoint to the backend.
STORAGE_BACKEND=s3
S3_BUCKET=documents
S3_REGION=us-east-1

# --- Optional ---------------------------------------------------------------
# Langfuse. Tracing is a no-op when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# API worker processes (uvicorn reads WEB_CONCURRENCY). Each process keeps up to 10 database
# connections. The development stack runs one process with reload, whatever the value.
WEB_CONCURRENCY=1

# Set by Docker Compose from infra/.env. Only for a backend run outside Docker:
# DATABASE_URL=postgresql://app:change-me@localhost:5432/app
# CACHE_URL=redis://localhost:6379/0
# S3_ENDPOINT_URL=http://localhost:8333
# S3_ACCESS_KEY=dev-access
# S3_SECRET_KEY=change-me
