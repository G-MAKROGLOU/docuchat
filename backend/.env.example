# Backend: API, ingest worker and corpus init. infra/setup.sh (Windows: infra\setup.ps1)
# copies this file to .env. Do not commit .env.

# --- Required ---------------------------------------------------------------
# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (OpenRouter model IDs)
# Intake, rewrite and grade use a cheap model; only the answer uses the stronger one.
# The eval in backend/evals scored Haiku for rewrite and grade as high as Opus at about 60% less cost.
LLM_CHAT_MODEL=anthropic/claude-haiku-5.5
LLM_REWRITE_MODEL=anthropic/claude-haiku-5.5
LLM_GRADE_MODEL=anthropic/claude-haiku-5.5
LLM_GENERATE_MODEL=anthropic/claude-opus-5.5
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Prefix each embedded chunk with its drug and section (true or false, for the ablation).
EMBEDDING_PREFIX=true

# Object storage. STORAGE_BACKEND is s3 or filesystem. The S3 keys are in infra/.env; Docker
# Compose passes them and the endpoint to the backend.
STORAGE_BACKEND=s3
S3_BUCKET=documents
S3_REGION=us-east-1

# --- Tuning (required) ------------------------------------------------------
# Every number the code uses. The values below are the measured or calibrated ones.

# Database pool, per process. Size it against Postgres max_connections times the processes.
# The ingest worker needs DB_POOL_MAX_SIZE above 2 times INGEST_CONCURRENCY.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_STATEMENT_TIMEOUT_MS=30000
# Wait for a free connection, and the number of waiting requests before new ones fail.
DB_POOL_TIMEOUT_SECONDS=10
DB_POOL_MAX_WAITING=256
# Must stay below the 5 s timeout of the compose healthcheck.
DB_PROBE_TIMEOUT_SECONDS=3

# Shared cache (Redis). A slow cache counts as a miss after the timeout.
CACHE_TIMEOUT_SECONDS=0.5
CACHE_EMBEDDING_TTL_SECONDS=2592000
CACHE_CHAT_TTL_SECONDS=604800

# Model clients (OpenRouter).
MODEL_TIMEOUT_SECONDS=60
CHAT_MODEL_MAX_RETRIES=1
EMBEDDING_MAX_RETRIES=3
EMBEDDING_BATCH_SIZE=100
MODEL_LIST_TTL_SECONDS=600
MODEL_LIST_TIMEOUT_SECONDS=30
STREAM_FIRST_BACKOFF_SECONDS=1
STREAM_MAX_BACKOFF_SECONDS=10
# Output limits per role, in tokens. The reasoning effort counts toward them too.
MAX_OUTPUT_TOKENS_CHAT=1024
MAX_OUTPUT_TOKENS_REWRITE=1024
MAX_OUTPUT_TOKENS_GRADE=2048
MAX_OUTPUT_TOKENS_GENERATE=8192

# Chat turn. CHAT_HISTORY_TURNS counts messages, not exchanges.
CHAT_HISTORY_TURNS=10
CHAT_MAX_QUERY_CHARS=500
CHAT_GRADE_RETRIES=1
CHAT_TURN_DEADLINE_SECONDS=120
CHAT_MAX_REPLY_CHARS=500
# The intake prompt lists the library only up to this many medicines (token budget).
CHAT_INTAKE_LIST_MAX=100
CHAT_MAX_SUGGESTIONS=3
CHAT_MAX_SUGGESTION_CHARS=120

# Search and context selection.
SEARCH_RRF_K=60
SEARCH_MAX_CHUNKS=8
SEARCH_TOKEN_BUDGET=3500
SEARCH_MIN_PER_DRUG=3
SEARCH_LEG_TIMEOUT_SECONDS=5
# BM25 score factors: a section title match, and the query words in order.
SEARCH_TITLE_BOOST=0.5
SEARCH_PHRASE_BOOST=2
# HNSW candidate list. At 1M chunks, recall@20 was 0.72 with the default 40 and 0.80 with 120,
# about 2 ms slower (measured on 2026-11-23).
SEARCH_HNSW_EF_SEARCH=120

# Defaults of the Settings page values, until the user saves others.
DEFAULT_CHUNK_TOKENS=500
DEFAULT_OVERLAP_TOKENS=50
DEFAULT_TOP_K=20

# Drug detection. Calibrated on the 53-label library (python -m evals.detector_calibration).
DETECTOR_MIN_KEY_LENGTH=4
DETECTOR_MIN_TAIL_LENGTH=7
DETECTOR_FUZZY_THRESHOLD=80
DETECTOR_CANDIDATE_FLOOR=70
DETECTOR_AMBIGUITY_MARGIN=12
DETECTOR_MAX_CHOICES=5
DETECTOR_REBUILD_SECONDS=30

# Ingestion of one label: excerpt anchors, page location in the PDF, failure text.
CHUNK_ANCHOR_WORDS=8
INGEST_MAX_PAGE_MISSES=0.2
LOCATOR_WINDOW=40
LOCATOR_MIN_PIECE=12
LOCATOR_SLACK=300
LOCATOR_MAX_SPAN=2
PDF_ROW_TOLERANCE=3
FAILURE_REASON_MAX_CHARS=500

# Ingest worker. The healthcheck of the ingest-worker service uses the heartbeat limit too.
WORKER_TICK_SECONDS=1
WORKER_HEARTBEAT_LIMIT_SECONDS=60
INGEST_SCHEDULE_HOURS=24
INGEST_CONCURRENCY=4
LABEL_QUEUE_BATCH=50
UPDATE_CHECK_CONCURRENCY=4
RUNTIME_REFRESH_SECONDS=1

# Label source (DailyMed): pause between requests, response limit, retries, timeouts.
SOURCE_DELAY_SECONDS=0.3
SOURCE_MAX_BYTES=52428800
SOURCE_ATTEMPTS=3
SOURCE_FIRST_BACKOFF_SECONDS=1
SOURCE_TIMEOUT_SECONDS=60
CATALOG_TIMEOUT_SECONDS=30
LABEL_SEARCH_LIMIT=20
LABEL_FETCH_LIMIT=50

# API.
STORAGE_STREAM_CHUNK_BYTES=65536
THUMBNAIL_WIDTH=320
THUMBNAIL_CONCURRENCY=4
THUMBNAIL_TTL_SECONDS=2592000
THUMBNAIL_MAX_AGE_SECONDS=86400
READINESS_CHECK_TIMEOUT_SECONDS=2
POOL_METRICS_INTERVAL_SECONDS=5

# --- Optional ---------------------------------------------------------------
# Langfuse. Tracing is a no-op when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# API worker processes (uvicorn reads WEB_CONCURRENCY). Each process keeps up to 10 database
# connections. The development stack runs one process with reload, whatever the value.
WEB_CONCURRENCY=1

# Set by Docker Compose from infra/.env. Only for a backend run outside Docker:
# DATABASE_URL=postgresql://app:change-me@localhost:5432/app
# CACHE_URL=redis://localhost:6379/0
# S3_ENDPOINT_URL=http://localhost:8333
# S3_ACCESS_KEY=dev-access
# S3_SECRET_KEY=change-me
