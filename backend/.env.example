# Backend alone (compose.dev.yml). Copy to .env and set the values. Do not commit .env.

# Database. compose.dev.yml builds DATABASE_URL from these values.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app
# Used only when the backend runs outside Docker Compose.
DATABASE_URL=postgresql://app:change-me@localhost:5432/app

# OpenRouter (required)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (OpenRouter model IDs, required)
LLM_REWRITE_MODEL=
LLM_GRADE_MODEL=
LLM_GENERATE_MODEL=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=

# Langfuse (optional). Tracing is a no-op when these are empty.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Object storage. STORAGE_BACKEND is s3 or filesystem.
STORAGE_BACKEND=s3
S3_BUCKET=documents
S3_REGION=us-east-1
# compose.dev.yml sets the endpoint to the storage service. Empty means real AWS S3.
S3_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=dev-access
S3_SECRET_KEY=change-me
# Used only when STORAGE_BACKEND=filesystem.
STORAGE_FS_ROOT=

# Host ports
BACKEND_PORT=8000
DB_PORT=5432
STORAGE_PORT=8333

# Hot reload: Uvicorn uses its stat-based reloader, which polls the files.
# It works on Windows, macOS and Linux hosts. No variable is necessary.
