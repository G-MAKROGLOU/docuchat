# Frontend. infra/setup.sh (Windows: infra\setup.ps1) copies this file to .env. Do not commit .env.
# Nothing is required: the values below work for a local run.

# Backend base URL. The proxy route forwards /api/* to ${BACKEND_URL}/api/*; the browser never
# calls this host directly. In Docker Compose the frontend uses http://backend:8000 (set there).
# Frontend on the host, backend in Docker: http://localhost:<BACKEND_PORT in infra/.env>
BACKEND_URL=http://localhost:8000

# Schema source for `npm run contract:generate`: a URL or a file.
# Default: ../backend/contract (the committed copy).
CONTRACT_SOURCE=

# Links on the Health page, as the browser reaches them (ports from infra/.env).
GRAFANA_URL=http://127.0.0.1:3001
PROMETHEUS_URL=http://127.0.0.1:9090
# The Langfuse project page, for example https://cloud.langfuse.com/project/<project id>.
# Empty: the Health page shows no Langfuse tile.
LANGFUSE_URL=

# Hot reload. Bind mounts from Windows and macOS hosts do not forward file system events,
# so the watchers poll the files. On a native Linux host, leave both empty.
# Turbopack watcher (next.config.ts, watchOptions.pollIntervalMs), in milliseconds.
NEXT_WATCH_POLL_INTERVAL_MS=1000
# Next.js Watchpack watcher (new routes, .env files).
WATCHPACK_POLLING=true
