{
  "title": "StreamEvent",
  "$defs": {
    "ErrorEvent": {
      "properties": {
        "type": {
          "const": "error",
          "default": "error",
          "title": "Type",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "ErrorEvent",
      "type": "object"
    },
    "FinalEvent": {
      "properties": {
        "type": {
          "const": "final",
          "default": "final",
          "title": "Type",
          "type": "string"
        },
        "answer": {
          "title": "Answer",
          "type": "string"
        },
        "citations": {
          "items": {
            "type": "string"
          },
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "type",
        "answer",
        "citations"
      ],
      "title": "FinalEvent",
      "type": "object"
    },
    "RefusalEvent": {
      "properties": {
        "type": {
          "const": "refusal",
          "default": "refusal",
          "title": "Type",
          "type": "string"
        },
        "reason": {
          "enum": [
            "no_relevant_context",
            "no_valid_citation",
            "out_of_scope"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "type",
        "reason"
      ],
      "title": "RefusalEvent",
      "type": "object"
    },
    "Source": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "document": {
          "title": "Document",
          "type": "string"
        },
        "drug": {
          "title": "Drug",
          "type": "string"
        },
        "section": {
          "title": "Section",
          "type": "string"
        },
        "page": {
          "title": "Page",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "document",
        "drug",
        "section",
        "page",
        "text"
      ],
      "title": "Source",
      "type": "object"
    },
    "SourcesEvent": {
      "properties": {
        "type": {
          "const": "sources",
          "default": "sources",
          "title": "Type",
          "type": "string"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type",
        "items"
      ],
      "title": "SourcesEvent",
      "type": "object"
    },
    "StatusEvent": {
      "properties": {
        "type": {
          "const": "status",
          "default": "status",
          "title": "Type",
          "type": "string"
        },
        "stage": {
          "enum": [
            "rewrite",
            "retrieve",
            "grade",
            "generate"
          ],
          "title": "Stage",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "type",
        "stage",
        "message"
      ],
      "title": "StatusEvent",
      "type": "object"
    },
    "TokenEvent": {
      "properties": {
        "type": {
          "const": "token",
          "default": "token",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "type",
        "text"
      ],
      "title": "TokenEvent",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "error": "#/$defs/ErrorEvent",
      "final": "#/$defs/FinalEvent",
      "refusal": "#/$defs/RefusalEvent",
      "sources": "#/$defs/SourcesEvent",
      "status": "#/$defs/StatusEvent",
      "token": "#/$defs/TokenEvent"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/StatusEvent"
    },
    {
      "$ref": "#/$defs/SourcesEvent"
    },
    {
      "$ref": "#/$defs/TokenEvent"
    },
    {
      "$ref": "#/$defs/FinalEvent"
    },
    {
      "$ref": "#/$defs/RefusalEvent"
    },
    {
      "$ref": "#/$defs/ErrorEvent"
    }
  ]
}
