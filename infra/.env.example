# Infrastructure: database, object store, monitoring and host ports. setup.sh (Windows:
# setup.ps1) copies this file to .env. The values work for a local run. Do not commit .env.

# Database. Compose builds the backend DATABASE_URL from these values.
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# Object store keys. Compose gives them to the store and to the backend.
S3_ACCESS_KEY=dev-access
S3_SECRET_KEY=change-me

# Grafana. The dashboards open without a login (read only); editing needs the admin password.
GRAFANA_ADMIN_PASSWORD=change-me

# Host ports. Change one when setup reports that the port is in use.
FRONTEND_PORT=3000
BACKEND_PORT=8000
DB_PORT=5432
STORAGE_PORT=8333
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
